# Doxyfile for librbipc
PROJECT_NAME           = "librbipc"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Ultra-Low-Latency Zero-Copy Shared-Memory IPC Ring Buffer Library"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Input configuration
INPUT                  = include src README.md BENCHMARK_REPORT.md BENCHMARK_ICEORYX2_COMPARISON.md
USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.c *.md
EXCLUDE_PATTERNS       = */build/* */bin/* */.git/* docs/*

# Extraction options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Warning options
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

# Preprocessor configuration
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include src
PREDEFINED             = "RBIPC_NODISCARD=" \
                         "RBIPC_INLINE=inline" \
                         "RBIPC_PURE=" \
                         "RBIPC_CONST=" \
                         "RBIPC_LEAF=" \
                         "RBIPC_HOT=" \
                         "RBIPC_COLD=" \
                         "RBIPC_RESTRICT=restrict" \
                         "RBIPC_ALIGNED(x)=" \
                         "RBIPC_ASSUME_ALIGNED(ptr,x)=ptr" \
                         "RBIPC_PACKED=" \
                         "RBIPC_EXPORT=" \
                         "__attribute__(x)=" \
                         "_Atomic(x)=x"

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_EXTRA_FILES       = LICENSE
GENERATE_LATEX         = NO
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3


