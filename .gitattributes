# Set default behavior to automatically handle line endings and force LF in repository and working tree
* text=auto eol=lf

# C / C++ Source and Header files
*.c text diff=cpp eol=lf
*.h text diff=cpp eol=lf
*.cpp text diff=cpp eol=lf
*.hpp text diff=cpp eol=lf

# Build and Configuration
Makefile text eol=lf
*.mk text eol=lf
Doxyfile text eol=lf
.clangd text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.vscode/*.json text eol=lf

# Documentation and Data
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.py text diff=python eol=lf

# Windows scripts (require CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.so binary
*.dylib binary
*.dll binary
*.a binary
*.lib binary
*.o binary
*.obj binary
*.exe binary
*.bin binary
*.tar binary
*.gz binary
*.zip binary
# Benchmark backward-compatibility symlinks (disable text filter on symlinks)
benchmarks/results/*.json -text
