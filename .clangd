CompileFlags:
  CompilationDatabase: .
  Add:
    - -Iinclude
    - -Isrc
    - -Isrc/core
    - -Isrc/memory
    - -Isrc/sync
    - -Isrc/io
    - -Isrc/ipc
    - -Isrc/audit
    - -Isrc/platform
    - -Ibenchmarks
    - -D_GNU_SOURCE
    - -Wall
    - -Wextra
    - -Wpedantic

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  Suppress:
    - unused-includes

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -std=c23

---
If:
  PathMatch: .*\.c
CompileFlags:
  Add:
    - -xc
    - -std=c23
