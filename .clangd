CompileFlags:
  CompilationDatabase: .
  Add:
    - -Iinclude
    - -Isrc
    - -Isrc/core
    - -Isrc/memory
    - -Isrc/sync
    - -Isrc/io
    - -Isrc/ipc
    - -Isrc/audit
    - -Isrc/platform
    - -Ibenchmarks
    - -D_GNU_SOURCE
    - -Wall
    - -Wextra
    - -Wpedantic

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  Suppress:
    - unused-includes

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -std=c23

---
If:
  PathMatch: .*\.c
CompileFlags:
  Add:
    - -xc
    - -std=c23

---
# C++ test files (e.g. tests/core/test_unit_cpp_compat.cpp) must NOT inherit
# the C standard from compile_flags.txt / compile_commands.json. Override to
# the C++ standard used by the Makefile (see Makefile:97).
If:
  PathMatch: .*\.cpp
CompileFlags:
  Add:
    - -xc++
    - -std=c++20
